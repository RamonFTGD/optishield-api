{
  "name": "optishield-api",
  "version": "2.0.0",
  "description": "Cliente oficial para la API de OptiShield. Más de 30 scrapers: YouTube, TikTok, Instagram, Facebook, Spotify, Pinterest, Minecraft mods, clima, traductor, stalker y 5 motores de IA (orquestador + nova-ai, heckai, gptanon, google-gemma). Incluye workers con polling, subida de archivos con expiración y acortador de URLs.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "optishield",
    "youtube-downloader",
    "tiktok-downloader",
    "instagram-downloader",
    "facebook-downloader",
    "spotify-downloader",
    "pinterest-downloader",
    "scraper",
    "whatsapp-bot",
    "chatbot",
    "ai",
    "gpt",
    "gemma",
    "nova-ai",
    "heckai",
    "gptanon",
    "file-upload",
    "worker-pooling",
    "short-url",
    "mcmods"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RamonFTGD/optishield-api.git"
  },
  "bugs": {
    "url": "https://github.com/RamonFTGD/optishield-api/issues"
  },
  "homepage": "https://optishield.uk/",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
